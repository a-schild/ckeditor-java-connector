<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.aarboard</groupId>
        <artifactId>ckeditor-java-connector-project</artifactId>
        <version>2.0.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>
    <artifactId>ckeditor-java-connector</artifactId>
    <version>2.0.0-SNAPSHOT</version>
    <packaging>jar</packaging>
    <name>WEB - ${project.artifactId}</name>

    <!--
        Vaadin 8 port. Compared with the 1.0.x (Vaadin 6.8.18) line this drops the
        custom GWT widgetset (VaadinWidgetset) entirely: the UI now uses only stock
        Vaadin 8 components, so the consuming WAR's own widgetset (which already
        inherits com.vaadin.v7.Vaadin7WidgetSet) serves it. The Vaadin 6 add-ons
        easyuploads / notifique / borderlayout / sessionguard were removed and
        replaced with core Vaadin 8 mechanisms; confirmdialog moves to its Vaadin 8
        (3.x) release. Data-model / Table use the com.vaadin.v7 compatibility layer.
    -->
    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven-compiler-plugin.version>3.8.1</maven-compiler-plugin.version>
        <maven-jar-plugin.version>3.1.2</maven-jar-plugin.version>
        <vaadin.version>8.14.0</vaadin.version>
        <slf4j-api.version>1.7.36</slf4j-api.version>
        <commons-text.version>1.9</commons-text.version>
        <commons-io.version>2.7</commons-io.version>
        <commons-fileupload.version>1.5</commons-fileupload.version>
        <confirmdialog.version>3.2.0</confirmdialog.version>
        <javax-servlet.version>3.1.0</javax-servlet.version>
    </properties>

    <build>
        <finalName>ckeditor-java-connector</finalName>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <includes>
                    <include>**/*</include>
                </includes>
            </resource>
        </resources>

        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>${maven-compiler-plugin.version}</version>
                <configuration>
                    <source>${maven.compiler.source}</source>
                    <target>${maven.compiler.target}</target>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>${maven-jar-plugin.version}</version>
            </plugin>
        </plugins>
    </build>

    <dependencies>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <version>${slf4j-api.version}</version>
        </dependency>

        <!-- Provided by the consuming WAR (aarcat2-web / the 8.1.x chain) -->
        <dependency>
            <groupId>com.vaadin</groupId>
            <artifactId>vaadin-server</artifactId>
            <version>${vaadin.version}</version>
            <scope>provided</scope>
        </dependency>
        <!-- v7 compatibility layer: Table/TreeTable, IndexedContainer, Property, ItemClickEvent -->
        <dependency>
            <groupId>com.vaadin</groupId>
            <artifactId>vaadin-compatibility-server</artifactId>
            <version>${vaadin.version}</version>
            <scope>provided</scope>
        </dependency>

        <!-- Vaadin 8 (3.x) release of the confirm dialog add-on -->
        <dependency>
            <groupId>org.vaadin.addon</groupId>
            <artifactId>confirmdialog</artifactId>
            <version>${confirmdialog.version}</version>
        </dependency>

        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-text</artifactId>
            <version>${commons-text.version}</version>
        </dependency>
        <dependency>
            <groupId>commons-io</groupId>
            <artifactId>commons-io</artifactId>
            <version>${commons-io.version}</version>
        </dependency>
        <dependency>
            <groupId>commons-fileupload</groupId>
            <artifactId>commons-fileupload</artifactId>
            <version>${commons-fileupload.version}</version>
        </dependency>

        <dependency>
            <groupId>javax.servlet</groupId>
            <artifactId>javax.servlet-api</artifactId>
            <version>${javax-servlet.version}</version>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <repositories>
        <repository>
            <id>vaadin-addons</id>
            <url>https://maven.vaadin.com/vaadin-addons</url>
        </repository>
    </repositories>

    <scm>
        <connection>scm:git:git://github.com/a-schild/ckeditor-java-connector.git</connection>
        <developerConnection>scm:git:git@github.com:a-schild/ckeditor-java-connector.git</developerConnection>
        <url>https://github.com/a-schild/ckeditor-java-connector</url>
        <tag>HEAD</tag>
    </scm>
</project>
